{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "description": "Three Kingdoms Platform - Node.js API",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "eslint . --ext ts --report-unused-disable-directives --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@apollo/server": "^4.9.0",
    "@fastify/cors": "^8.4.0",
    "@prisma/client": "^5.7.0",
    "fastify": "^4.25.0",
    "graphql": "^16.8.0",
    "graphql-scalars": "^1.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.55.0",
    "prisma": "^5.7.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  }
}
